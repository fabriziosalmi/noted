# eslint-plugin-jsx-a11y@6.10.2 still declares a peer range that stops at
# eslint 9, but this project is on eslint 10. legacy-peer-deps lets
# `npm ci` / `npm install` resolve cleanly (matching how the tree is already
# installed), so a fresh clone — including CI and Homebrew builds — installs
# without needing an extra --legacy-peer-deps flag.
legacy-peer-deps=true
