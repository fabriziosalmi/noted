# Apple credentials for codesign + notarization, read by scripts/release.sh.
# Copy to .env.local (gitignored) and fill in. Never commit real values.
#
# APPLE_ID                     Your Apple ID email.
# APPLE_TEAM_ID                Developer Team ID (Developer ID Application cert).
# APPLE_APP_SPECIFIC_PASSWORD  From appleid.apple.com -> App-Specific Passwords.
APPLE_ID="your.apple.id@example.com"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
